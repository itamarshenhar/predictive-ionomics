#!/bin/bash
# Shared environment for the HURCS SHAP run. EDIT THIS ONE FILE, then every
# other script / sbatch sources it. Sourced — do not `sbatch` this file.
#
# HURCS facts baked in:
#   * home (~) has a HARD 5 GB limit -> venv, pip, and ALL caches live in /sci/labs
#   * GPUs (pricing page, eff. 2025-06-01): H200 $0.50, A100 $0.40, L40 $0.20,
#     L4 $0.10 per hour. A30 retired. Default below = L40 (cheap + plentiful ->
#     best wall-clock for a 12-target array). Use h200 for fastest single stream.
#   * CPU nodes: Glacier (38 nodes). Scheduler: SLURM.
#
# >>> THINGS YOU MUST SET <<<  (copy this file to env.sh — env.sh is gitignored)
PI=""                            # the PI's HURCS username -> /sci/labs/<PI>
USER_DIR=""                      # your personal subdir under the lab
if [ -z "$PI" ] || [ -z "$USER_DIR" ]; then
  echo "ERROR: set PI and USER_DIR at the top of slurm/env.sh first." >&2
  return 1 2>/dev/null || exit 1
fi
# Root of all heavy work (NEVER use $HOME — it will fill the 5 GB quota):
export LAB_ROOT="/sci/labs/${PI}/${USER_DIR}"

# Project + environment locations (under LAB_ROOT, not home).
# Dedicated cluster folder name — deliberately DIFFERENT from your live local
# project so a Mac-side rsync of your local work can never collide with the
# cluster run. Seed it once with stage_for_cluster.sh, then leave it alone.
PROJECT_DIRNAME="${PROJECT_DIRNAME:-shap_cluster_run}"
export PROJECT="${LAB_ROOT}/${PROJECT_DIRNAME}"
export VENV="${LAB_ROOT}/envs/ionome"

# The authoritative run directory. NO FALLBACK ON PURPOSE: every job must be
# given RUN_DIR explicitly (submit_train_all.sh passes it via
# `sbatch --export=ALL,RUN_DIR=...`). A default here would silently make a bare
# `sbatch slurm/<job>.sbatch` train into — and overwrite — a previous run dir,
# and would render the `: "${RUN_DIR:?}"` guards in every sbatch dead code.
export RUN_DIR="${RUN_DIR:-}"

# Dataset — the SHAP run uses ONLY this main DB.
export DATA_PATH="${LAB_ROOT}/data/Min_Bal_DB_24.05.26.xlsx"
# OPTIONAL: the control/farmer table is NOT used by the SHAP run. It is only
# needed if you also run the separate commercial-farm external validation
# (validate_farmer.py etc.). Leave it; it's harmless if the file isn't present.
export FARMER_PATH="${LAB_ROOT}/data/Contro_Table_DB_27.05.26_rounded.xlsx"

# --- Redirect every cache off the 5 GB home onto lab storage -----------------
# TabPFN downloads its v3 checkpoint and torch/HF cache models; on home this
# bricks your login. These env vars + the ~/.cache symlink (see setup_env.sh)
# keep everything in /sci/labs.
export XDG_CACHE_HOME="${LAB_ROOT}/.cache"
export HF_HOME="${LAB_ROOT}/.cache/huggingface"
export HUGGINGFACE_HUB_CACHE="${LAB_ROOT}/.cache/huggingface/hub"
export TORCH_HOME="${LAB_ROOT}/.cache/torch"
export PIP_CACHE_DIR="${LAB_ROOT}/.cache/pip"
export TMPDIR="${LAB_ROOT}/tmp"
mkdir -p "$XDG_CACHE_HOME" "$HF_HOME" "$HUGGINGFACE_HUB_CACHE" \
         "$TORCH_HOME" "$PIP_CACHE_DIR" "$TMPDIR" 2>/dev/null

# --- SLURM resource names (confirmed via `sinfo` on moriah) -------------------
# GPU partitions: salmon=L40S(10x8), dogfish=A100(2x8), goldfish=H200(1x8),
#   catfish=L4(5x8). CPU partition: glacier (38 nodes, default). The "-k" twins
#   are killable/preemptible. We use salmon (80 L40S -> max parallelism, cheap).
export GPU_PARTITION="${GPU_PARTITION:-goldfish}" # H200 partition (1 node x 8 = 8 GPUs, fastest)
export CPU_PARTITION="${CPU_PARTITION:-glacier}"  # CPU partition
export GPU_GRES="${GPU_GRES:-gpu:h200:1}"         # one H200 per task
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-$PI}"      # lab account (srun reads SLURM_ACCOUNT)
export SBATCH_ACCOUNT="$SLURM_ACCOUNT"            # sbatch reads SBATCH_ACCOUNT
export SALLOC_ACCOUNT="$SLURM_ACCOUNT"            # salloc reads SALLOC_ACCOUNT
